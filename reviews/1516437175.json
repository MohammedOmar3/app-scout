{"id":"1516437175","reviews":[{"rid":"14752504136","stars":1,"title":"前の方が良かった","text":"月が変わるとページめくりたい","version":"1.18","votes":0,"helpful":0,"date":"2026-11-04","cc":"jp"},{"rid":"14745948346","stars":2,"title":"これしかない！と思えなくて残念","text":"旧型 一択で15年ほど使用してきました。スクロールで月移動が早くできるのは良いのですが、1ヶ月単位で見たい時に動きやすい。日にちの区切りの横線をもう少し濃くしたい。件名の長さをfullに設定したい。やはり旧型を手放せない。","version":"1.18","votes":0,"helpful":0,"date":"2026-11-03","cc":"jp"},{"rid":"14702292772","stars":1,"title":"残念","text":"前の方が見易い","version":"1.18","votes":0,"helpful":0,"date":"2026-10-23","cc":"jp"},{"rid":"14668853799","stars":2,"title":"縦型カレンダー愛用者","text":"長年お世話になった縦型カレンダーがサポート終了ということで、後継アプリとされる縦型手帳をDLしました。\n\nしかし、縦型カレンダーの最も良かった一月がスクロールせずに観れるという最大の長所がなくなっている。\n\nこれなら他のアプリと大差ない。\nどうして最大の長所を無くしたのか…残念でなりません。","version":"1.18","votes":0,"helpful":0,"date":"2026-10-15","cc":"jp"},{"rid":"13496824328","stars":1,"title":"微妙","text":"有料版のプロフェッショナルにしても画像をたった100枚までとか少なすぎる。カレンダーの予定に結構、画像を今入れているのを考えるととても少なく感じる。","version":"1.18","votes":0,"helpful":0,"date":"2025-12-10","cc":"jp"}],"app":{"name":"縦型手帳：予定表アプリ&システム手帳・日記アプリ・日程表","seller":"UNITAC CO.,LTD","genre":"Productivity","rating":4.2439,"ratings":533,"price":"無料","updated":"2025-10-24","url":"https://apps.apple.com/jp/app/%E7%B8%A6%E5%9E%8B%E6%89%8B%E5%B8%B3-%E4%BA%88%E5%AE%9A%E8%A1%A8%E3%82%A2%E3%83%97%E3%83%AA-%E3%82%B7%E3%82%B9%E3%83%86%E3%83%A0%E6%89%8B%E5%B8%B3-%E6%97%A5%E8%A8%98%E3%82%A2%E3%83%97%E3%83%AA-%E6%97%A5%E7%A8%8B%E8%A1%A8/id1516437175?uo=4","focus":["target-competitor"]},"last_scanned":"2026-11-15","stats":{"jp":{"fetched":30,"hist":{"1":7,"2":4,"3":5,"4":5,"5":9},"newest":"2026-11-04","oldest":"2021-08-18"},"us":{"fetched":2,"hist":{"1":1,"2":0,"3":0,"4":1,"5":0},"newest":"2023-09-23","oldest":"2021-08-18"},"gb":{"fetched":1,"hist":{"1":0,"2":0,"3":0,"4":0,"5":1},"newest":"2024-06-07","oldest":"2024-06-07"}}}